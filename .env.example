# ==============================================================================
# DAT Tutor — Environment Configuration Template (.env.example)
#
# Copy this file to .env and configure your OpenAI-compatible API endpoints
# for vLLM, HuggingFace Inference Endpoints, OpenRouter, or local GPU servers.
# If these environment variables are unset, the tutor falls back 100% offline
# to deterministic mock generators so that offline development and tests never break.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Main Text LLM: Gemma4-12B (FP8)
# Used for grounded reasoning, pedagogical tutoring, and citation formatting.
# ------------------------------------------------------------------------------
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=google/gemma-4-12b-it-fp8

# ------------------------------------------------------------------------------
# 2. Vision-Language Model (VLM): zai-org/GLM-4.6V-Flash
# Used for visual question-answering over slide pages and video keyframes.
# ------------------------------------------------------------------------------
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=zai-org/GLM-4.6V-Flash

# ------------------------------------------------------------------------------
# 3. OCR Vision-Language Model: PaddlePaddle/PaddleOCR-VL-1.6
# Used for high-precision text, code, and formula extraction from slides & keyframes.
# ------------------------------------------------------------------------------
OCR_API_KEY=your_ocr_api_key_here
OCR_BASE_URL=https://api.openai.com/v1
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.6

# ------------------------------------------------------------------------------
# 4. Optional Legacy Fallback APIs
# Used if LLM_* or VISION_* are unset
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local Storage & Database Paths
# ------------------------------------------------------------------------------
CORPUS_DB_PATH=data/corpus.db
MEMORY_DB_PATH=data/learner_memory.db
KEYFRAMES_DIR=data/keyframes
AUDIO_DIR=data/audio
MANIFEST_PATH=data/source_manifest.json
